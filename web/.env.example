# Copy to .env and adjust. Every value has a working local default.

# Database (SQLite file next to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Authentication (NextAuth.js). Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Demo data: seed demo accounts and sample data into an empty database, and show
# the one-click demo accounts on the sign-in page. Both default to off in production.
SEED_DEMO=true
SHOW_DEMO_ACCOUNTS=true
# Without demo data, this administrator is created on first run instead.
# ADMIN_EMAIL=admin@example.org
# ADMIN_PASSWORD=

# llm-access PDP (FastAPI). Empty: decisions and the assistant use local sample data.
LLM_ACCESS_API_URL=
# LLM_ACCESS_API_URL=http://localhost:8080
# LLM_ACCESS_API_TOKEN=
# LLM_ACCESS_CHAT_TIMEOUT_MS=180000

# Edge nodes: "mock" simulates them, "live" calls the ESP32s at the addresses in the
# Devices page. Gateway API tokens are read from the variables each device names.
IOT_MODE=mock
GW1_API_TOKEN=
GW2_API_TOKEN=
