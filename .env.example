# --- LLM (CrewAI model string: "<provider>/<model>") ---------------------------
# Anthropic (default):   anthropic/claude-opus-5-5   needs ANTHROPIC_API_KEY
# OpenAI:                openai/gpt-4o               needs OPENAI_API_KEY
# Ollama (local):        ollama/llama3.1             set LLM_ACCESS_LLM_BASE_URL=http://localhost:11434
LLM_ACCESS_LLM_MODEL=anthropic/claude-opus-5-5
ANTHROPIC_API_KEY=
# LLM_ACCESS_LLM_BASE_URL=
# LLM_ACCESS_LLM_API_KEY=

# --- Decision pipeline -----------------------------------------------------------
# off | on_permit | always    (agents can only ever turn a permit into a deny)
LLM_ACCESS_AGENT_REVIEW=on_permit
# deny | rules               what happens when the agent review fails or times out
LLM_ACCESS_AGENT_FAILURE_MODE=deny
LLM_ACCESS_AGENT_MIN_CONFIDENCE=0.7
# Seconds the PDP may spend on one request. Keep it below the gateway's pdpTimeoutMs.
LLM_ACCESS_DECISION_BUDGET_S=20

# --- Operations ------------------------------------------------------------------
# Allow agents to lock/unlock doors through the deployer (operator overrides).
LLM_ACCESS_ALLOW_ACTUATION=false
# live | dry_run             dry_run makes the deployer record plans without touching devices
LLM_ACCESS_DEPLOY_MODE=live

# --- Device secrets (names are referenced from config/inventory.yaml) ------------
GW1_API_TOKEN=
GW1_PDP_TOKEN=
GW1_DECISION_KEY=
GW2_API_TOKEN=
GW2_PDP_TOKEN=
GW2_DECISION_KEY=
